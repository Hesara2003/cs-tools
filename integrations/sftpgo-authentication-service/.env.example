#IdP Configuration (Internal Users)
INTERNAL_CLIENT_ID="YOUR_INTERNAL_CLIENT_ID"
INTERNAL_CLIENT_SECRET="YOUR_INTERNAL_CLIENT_SECRET"
INTERNAL_IDP_BASE_PATH="https://api.asgardeo.io/t/yourinternalorg"
CHECK_ROLE="internal" # The role display name to check for internal users

#External IdP Configuration (for non-@wso2.com users)
EXTERNAL_CLIENT_ID="YOUR_EXTERNAL_CLIENT_ID"
EXTERNAL_CLIENT_SECRET="YOUR_EXTERNAL_CLIENT_SECRET"
EXTERNAL_IDP_BASE_PATH="https://api.asgardeo.io/t/yourexternalorg"

#Common IdP Configuration
OAUTH_CALLBACK_URL="https://your-app/callback"
SCIM_SCOPE="internal_user_mgt_view" # The scope required to fetch user details from the IdP.
# Authenticator ID for BasicAuthenticator in the IdP flow. NOT a secret: this is a
# fixed, publicly-known value across WSO2 Identity Server / Asgardeo deployments --
# it's just base64("BasicAuthenticator:LOCAL"), the standard username/password
# authenticator identifier in the WSO2 identity platform, not a credential.
BASIC_AUTHENTICATOR_ID="QmFzaWNBdXRoZW50aWNhdG9yOkxPQ0FM"

#Subscription APIs
SUBSCRIPTION_API="https://api.example.com/subscriptions?customerEmail=%s"
PROJECT_API="https://api.example.com/projects?projectKey=%s"

#SFTPGo Admin API Configuration
SFTPGO_API_BASE="http://localhost:8080/api/v2"
ADMIN_USER="admin"
ADMIN_KEY="your-sftpgo-admin-api-key"

#SFTPGo User/Folder Configuration
FOLDER_PATH="/path/on/sftpgo/server"
DIR_PATH="/path/on/sftpgo/server"

#Database Connection (PostgreSQL) Format: postgres://user:password@host:port/dbname?sslmode=disable
DB_CONN_STRING="postgres://user:password@127.0.0.1:5432/sftpgo_sessions?sslmode=disable"

#Service Configuration
LOG_LEVEL="DEBUG" # DEBUG, INFO, WARN, ERROR
PORT="9090" # Port to listen on
HOOK_API_KEY="your-hook-api-key" # API key for authenticating hooks

#External-Auth Hook Configuration (web attachment access path)
#Validates the x-jwt-assertion the CSM backend forwards as the password on
#SFTPGo's GET /api/v2/user/token. Optional: if unset, the service still starts
#and the pre-login/keyboard-interactive hooks keep working, but the
#/external-auth-hook route fails closed (503) until these are set.
AUTH_JWKS_ENDPOINT="https://api.asgardeo.io/t/yourorg/oauth2/jwks"
AUTH_ISSUER="https://api.asgardeo.io/t/yourorg/oauth2/token"
AUTH_AUDIENCE="your-audience-1,your-audience-2" # comma-separated, OR-matched; leave unset to accept any audience
AUTH_TOKEN_VALIDATOR_ENABLED="true" # set to "false" only for local dev to skip signature verification

# Optional: Custom email validation regex pattern (uses Java-compatible default if not set)
# EMAIL_REGEX_PATTERN="your_custom_regex_pattern"
